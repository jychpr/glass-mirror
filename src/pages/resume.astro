<style is:global>
    /* === 1-PAGE RESUME COMPRESSION (v4 - Dual Language) === */
    
    /* 1. Web Display Padding */
    .a4-page {
        padding: 10mm 15mm !important; 
    }

    /* 2. Header */
    .cv-header { text-align: center; margin-bottom: 8px !important; }
    h1 { 
        margin: 0; 
        font-size: 16pt !important; 
        text-transform: uppercase; 
        letter-spacing: 1px; 
        line-height: 1.1; 
    }
    .chinese-name { font-weight: normal; margin-left: 8px; }
    
    .contact-info p { 
        margin: 1px 0 !important; 
        font-size: 9.5pt; 
        color: #333; 
    }
    .contact-info a { color: #000; text-decoration: none; border-bottom: 1px dotted #000; }

    /* 3. Section Headers */
    h2 { 
        font-size: 12pt !important; 
        border-bottom: 1.5px solid #333; 
        margin-top: 8px !important;     
        margin-bottom: 3px !important;  
        padding-bottom: 1px !important; 
        text-transform: uppercase; 
    }
    
    /* 4. Content Items */
    .item { margin-bottom: 4px !important; } 
    .row { display: flex; justify-content: space-between; align-items: baseline; }
    h3 { margin: 0; font-size: 10.5pt !important; font-weight: bold; }
    .date { font-size: 9.5pt; font-weight: bold; }
    .sub { margin: 0 !important; font-style: italic; font-size: 9.5pt; }
    
    /* 5. Bullet Points & Text */
    .details { 
        margin: 1px 0 0 16px !important; 
        padding: 0; 
        font-size: 9.5pt; 
        line-height: 1.3 !important; 
    }
    .details li { margin-bottom: 1px !important; }

    .skills { 
        font-size: 9.5pt; 
        line-height: 1.35 !important; 
        margin: 2px 0 !important; 
    }

    /* === THE WEB SEPARATOR === */
    /* This will show a nice dashed line on the website */
    .language-divider { 
        margin: 40px 0 !important; 
        border: 0; 
        border-top: 1px dashed #ccc; 
    }

    /* 6. STRICT PRINT OVERRIDES (LATEX MARGINS) */
    @media print {
        @page {
            /* 5mm top/bottom, 8mm left/right */
            margin: 5mm 8mm !important; 
            size: A4;
        }

        /* === MOBILE PDF OVERRIDE & ANTI-INFLATION === */
        html, body.cv-mode {
            /* Kills mobile text resizing dead in its tracks */
            -webkit-text-size-adjust: 100% !important;
            text-size-adjust: 100% !important;
            /* Forces absolute A4 width mapping */
            min-width: 210mm !important;
            max-width: 210mm !important;
            width: 210mm !important;
        }

        .a4-page {
            padding: 0 !important; 
            box-shadow: none;
            width: 210mm !important; 
            max-width: 210mm !important;
            margin: 0 !important;
        }
        /* ====================== */

        .page-break { display: none; }
        .language-divider { display: none !important; }
        
        .chinese-version { 
            display: block !important; 
            page-break-before: always;
            break-before: page;
        } 
        
        h2 { -webkit-print-color-adjust: exact; border-bottom: 1.5px solid black !important; }
        a { text-decoration: none; color: black; border: none; }
    }
</style>