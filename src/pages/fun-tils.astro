---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "Akihito's Random TIL's";

const funTILs = Object.values(import.meta.glob('./posts/fun-tils/*.md', { eager: true }));

// FILTERING LOGIC
const tils = funTILs.filter((post) => post.frontmatter.tags?.includes('til'));

// Add this line
tils.sort((a, b) => new Date(b.frontmatter.pubDate) - new Date(a.frontmatter.pubDate));
---

<BaseLayout pageTitle={pageTitle}>
    <h2>Random TIL's</h2>
    <p>Quick things I learnt along the way</p>

    <ul class="link-list">
        {tils.map((post) => (
            <li>
                <span class="label">{post.frontmatter.pubDate.slice(0,10)}</span>
                <a href={post.url}>{post.frontmatter.title}</a>
            </li>
        ))}
    </ul>
</BaseLayout>