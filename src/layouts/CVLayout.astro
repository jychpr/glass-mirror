---
import '../styles/global.css';
const { pageTitle } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
    </head>
    <body class="cv-mode">
        <div class="no-print download-bar">
            <a href="/" class="back-btn">← Back to Site</a>
            <button onclick="window.print()" class="print-btn">Save as PDF / Print</button>
        </div>

        <main class="a4-page">
            <slot />
        </main>
    </body>
</html>

<style is:global>
    /* === 1. DESKTOP / TABLET HORIZONTAL STYLES === */
    body.cv-mode {
        background-color: #525659;
        margin: 0 !important;
        padding: 2rem 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100vh;
        /* THE FIX: We destroy the 650px global limit so it can truly center */
        max-width: 100% !important; 
    }

    .a4-page {
        background: white;
        width: 100%;
        max-width: 210mm; /* Stays A4 size on big screens, shrinks on small ones */
        min-height: 297mm;
        padding: 10mm 15mm; /* Phones get 15px from the mobile block below */
        box-shadow: 0 0 15px rgba(0,0,0,0.3);
        margin-bottom: 2rem;
        color: #000;
        box-sizing: border-box;
    }

    .download-bar {
        position: fixed;
        top: 20px;
        right: 20px;
        background: #333;
        padding: 10px 20px;
        border-radius: 8px;
        display: flex;
        gap: 15px;
        z-index: 999;
        box-shadow: 0 4px 6px rgba(0,0,0,0.2);
    }
    
    .download-bar a, .download-bar button {
        color: white;
        text-decoration: none;
        font-weight: bold;
        font-family: sans-serif;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.9rem;
    }

    .download-bar button:hover {
        text-decoration: underline;
    }

    /* === 2. DOCUMENT STYLES (shared by the resume and the CV) === */
    /* Header */
    .cv-header { text-align: center; margin-bottom: 8px; }
    h1 {
        margin: 0;
        font-size: 16pt;
        text-transform: uppercase;
        letter-spacing: 1px;
        line-height: 1.1;
    }
    .chinese-name { font-weight: normal; margin-left: 8px; }

    .contact-info p {
        margin: 1px 0;
        font-size: 9.5pt;
        color: #333;
    }
    .contact-info a { color: #000; text-decoration: none; border-bottom: 1px dotted #000; }

    /* Section Headers */
    h2 {
        font-size: 12pt;
        border-bottom: 1.5px solid #333;
        margin-top: 8px;
        margin-bottom: 3px;
        padding-bottom: 1px;
        text-transform: uppercase;
    }

    /* Content Items */
    .item { margin-bottom: 4px; }
    .row { display: flex; justify-content: space-between; align-items: baseline; }
    h3 { margin: 0; font-size: 10.5pt; font-weight: bold; }
    .date { font-size: 9.5pt; font-weight: bold; }
    .sub { margin: 0; font-style: italic; font-size: 9.5pt; }

    /* Bullet Points & Text */
    .details {
        margin: 1px 0 0 16px;
        padding: 0;
        font-size: 9.5pt;
        line-height: 1.3;
    }
    .details li { margin-bottom: 1px; }

    .skills {
        font-size: 9.5pt;
        line-height: 1.35;
        margin: 2px 0;
    }

    /* Dashed separator between the two languages on the website */
    .language-divider {
        margin: 40px 0;
        border: 0;
        border-top: 1px dashed #ccc;
    }

    /* === 3. MOBILE VERTICAL STYLES === */
    /* Triggers only on screens smaller than an iPad */
    @media screen and (max-width: 768px) {
        body.cv-mode {
            padding: 3.5rem 0 0 0; /* Push content down so top bar doesn't cover text */
            background-color: white; 
        }
        .a4-page {
            padding: 15px 15px; /* Tighter padding for phone reading */
            box-shadow: none;
            margin-bottom: 0;
            min-height: auto;
        }
        .download-bar {
            top: 0;
            right: 0;
            left: 0;
            border-radius: 0; /* Spans edge-to-edge on mobile */
            justify-content: center;
            width: 100%;
            box-sizing: border-box;
        }
    }

    /* === 4. PRINT / PDF EXPORT STYLES === */
    @media print {
        @page {
            /* 5mm top/bottom, 8mm left/right */
            margin: 5mm 8mm;
            size: A4;
        }

        /* Mobile PDF override & anti-inflation: always lay out at A4 width,
           so PDFs made on a phone match desktop ones */
        html, body.cv-mode {
            -webkit-text-size-adjust: 100%;
            text-size-adjust: 100%;
            min-width: 210mm;
            max-width: 210mm;
            width: 210mm;
        }

        body.cv-mode {
            background: white;
            display: block;
            padding: 0;
        }

        .a4-page {
            width: 210mm;
            max-width: 210mm;
            height: auto;
            margin: 0;
            padding: 0;
            box-shadow: none;
            border: none;
        }

        .page-break,
        .language-divider {
            display: none;
        }

        .chinese-version {
            page-break-before: always;
            break-before: page;
            padding-top: 0;
        }

        .no-print {
            display: none !important;
        }

        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        h2 { border-bottom: 1.5px solid black; }
        a { text-decoration: none; color: black; border: none; }

        h2 {
            break-after: avoid;
        }
    }
</style>