---
import '../styles/global.css';
const { pageTitle } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
    </head>
    <body class="cv-mode">
        <div class="no-print download-bar">
            <a href="/" class="back-btn">← Back to Site</a>
            <button onclick="window.print()" class="print-btn">Save as PDF / Print</button>
        </div>

        <main class="a4-page">
            <slot />
        </main>
    </body>
</html>

<style is:global>
    /* === SCREEN STYLES === */
    body.cv-mode {
        background-color: #525659;
        margin: 0;
        padding: 2rem 1rem; /* Added side padding so it doesn't touch screen edges */
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100vh;
        width: 100%;
        box-sizing: border-box;
    }

    .a4-page {
        background: white;
        /* THE FIX: Use 100% width but max-width for desktop scaling */
        width: 100%;
        max-width: 210mm; 
        min-height: 297mm;
        padding: 15mm 20mm; 
        box-shadow: 0 0 15px rgba(0,0,0,0.3);
        margin-bottom: 2rem;
        color: #000;
        box-sizing: border-box;
        overflow-x: hidden; /* Prevent horizontal scroll */
    }

    .download-bar {
        position: fixed;
        top: 20px;
        right: 20px;
        background: #333;
        padding: 10px 20px;
        border-radius: 8px;
        display: flex;
        gap: 15px;
        z-index: 999;
        box-shadow: 0 4px 6px rgba(0,0,0,0.2);
    }
    
    .download-bar a, .download-bar button {
        color: white;
        text-decoration: none;
        font-weight: bold;
        font-family: sans-serif;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.9rem;
    }

    .download-bar button:hover {
        text-decoration: underline;
    }

    /* === MOBILE SCREEN FIX === */
    @media screen and (max-width: 768px) {
        body.cv-mode {
            padding: 4rem 0 0 0; /* Make room for the fixed top bar */
            background-color: white; /* Looks better on mobile */
        }
        .a4-page {
            padding: 20px 15px; /* Shrink margins so text fits on narrow screens */
            box-shadow: none; /* Remove shadow to look like a native mobile view */
            min-height: auto; /* Remove forced height */
        }
        .download-bar {
            top: 0;
            right: 0;
            left: 0;
            border-radius: 0; /* Span full width on phone */
            justify-content: center;
        }
    }

    /* === PRINT STYLES === */
    @media print {
        @page {
            margin: 15mm 20mm;
            size: A4;
        }
        
        body.cv-mode {
            background: white;
            display: block;
            padding: 0;
        }

        .a4-page {
            width: 100%;
            max-width: none;
            height: auto;
            min-height: 0;
            margin: 0;
            padding: 0; 
            box-shadow: none;
            border: none;
        }

        .page-break {
            display: none;
        }

        .chinese-version {
            page-break-before: always;
            padding-top: 0;
        }

        .no-print {
            display: none !important;
        }

        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        
        .section-block, .item {
            break-inside: auto;
        }
        
        h2 {
            break-after: avoid;
        }
    }
</style>