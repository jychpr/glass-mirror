---
import '../styles/global.css';
const { pageTitle } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
    </head>
    <body class="cv-mode">
        <div class="no-print download-bar">
            <a href="/" class="back-btn">← Back to Site</a>
            <button onclick="window.print()" class="print-btn">Save as PDF / Print</button>
        </div>

        <main class="a4-page">
            <slot />
        </main>
    </body>
</html>

<style is:global>
    /* === 1. DESKTOP / TABLET HORIZONTAL STYLES === */
    body.cv-mode {
        background-color: #525659;
        margin: 0 !important;
        padding: 2rem 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100vh;
        /* THE FIX: We destroy the 650px global limit so it can truly center */
        max-width: 100% !important; 
    }

    .a4-page {
        background: white;
        width: 100%;
        max-width: 210mm; /* Stays A4 size on big screens, shrinks on small ones */
        min-height: 297mm;
        padding: 15mm 20mm;
        box-shadow: 0 0 15px rgba(0,0,0,0.3);
        margin-bottom: 2rem;
        color: #000;
        box-sizing: border-box;
    }

    .download-bar {
        position: fixed;
        top: 20px;
        right: 20px;
        background: #333;
        padding: 10px 20px;
        border-radius: 8px;
        display: flex;
        gap: 15px;
        z-index: 999;
        box-shadow: 0 4px 6px rgba(0,0,0,0.2);
    }
    
    .download-bar a, .download-bar button {
        color: white;
        text-decoration: none;
        font-weight: bold;
        font-family: sans-serif;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.9rem;
    }

    .download-bar button:hover {
        text-decoration: underline;
    }

    /* === 2. MOBILE VERTICAL STYLES === */
    /* Triggers only on screens smaller than an iPad */
    @media screen and (max-width: 768px) {
        body.cv-mode {
            padding: 3.5rem 0 0 0; /* Push content down so top bar doesn't cover text */
            background-color: white; 
        }
        .a4-page {
            padding: 15px 15px; /* Tighter padding for phone reading */
            box-shadow: none;
            margin-bottom: 0;
            min-height: auto;
        }
        .download-bar {
            top: 0;
            right: 0;
            left: 0;
            border-radius: 0; /* Spans edge-to-edge on mobile */
            justify-content: center;
            width: 100%;
            box-sizing: border-box;
        }
    }

    /* === 3. PRINT / PDF EXPORT STYLES === */
    /* Left completely untouched to preserve your PDF output */
    @media print {
        @page {
            margin: 15mm 20mm;
            size: A4;
        }
        
        body.cv-mode {
            background: white;
            display: block;
            padding: 0;
        }

        .a4-page {
            width: 100%;
            max-width: none;
            height: auto;
            margin: 0;
            padding: 0;
            box-shadow: none;
            border: none;
        }

        .page-break {
            display: none;
        }

        .chinese-version {
            page-break-before: always;
            padding-top: 0;
        }

        .no-print {
            display: none !important;
        }

        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        
        .section-block, .item {
            break-inside: auto;
        }
        
        h2 {
            break-after: avoid;
        }
    }
</style>