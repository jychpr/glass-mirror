---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title}>
    <article class="blog-post">
        
        {frontmatter.image && (
            <img src={frontmatter.image.url} alt={frontmatter.image.alt || 'Article header'} class="hero-image" />
        )}

        <h1>{frontmatter.title}</h1>
        <div class="meta">
            <span>By {frontmatter.author}</span> • 
            <span>{frontmatter.pubDate.slice(0,10)}</span>
        </div>
        
        <hr />
        
        <div class="content">
            <slot />
        </div>
    </article>
</BaseLayout>

<style>
    .hero-image {
        width: 100%;
        height: auto;
        border-radius: 8px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    .meta {
        color: #666;
        font-size: 0.9rem;
        margin-bottom: 1rem;
    }
    .blog-post {
        margin-top: 2rem;
    }
    .content :global(h2) {
        margin-top: 2rem;
        border-bottom: none;
    }
    .content :global(ul) {
        margin-left: 1.5rem;
    }
</style>

<script>
    // Automatically open external links in a new tab
    const links = document.querySelectorAll('.content a');
    
    links.forEach(link => {
        // If the link points to a different domain than your website
        if (link.hostname !== window.location.hostname) {
            link.setAttribute('target', '_blank');
            // Security best practice for target="_blank"
            link.setAttribute('rel', 'noopener noreferrer'); 
        }
    });
</script>